# Публичный адрес приложения. На Vercel можно не задавать: возьмётся production-домен (*.vercel.app)
NEXT_PUBLIC_APP_URL=
# Username бота без @. Можно не задавать: определится через getMe по BOT_TOKEN
NEXT_PUBLIC_BOT_USERNAME=

# Postgres (Supabase → Connect → Transaction pooler, порт 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Только для локальной разработки: вход без Telegram (/api/auth/dev)
ALLOW_DEV_LOGIN=

# Telegram (этапы 4, 10)
BOT_TOKEN=
# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=
# Администраторы через запятую: числовые Telegram ID и/или @username
ADMIN_TG_IDS=
# Секрет webhook бота (любая случайная строка: A-Z, a-z, 0-9, _ и -)
WEBHOOK_SECRET=
# Секрет cron-эндпоинта (Vercel передаёт его в Authorization)
CRON_SECRET=
