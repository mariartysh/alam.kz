# Публичный адрес приложения
NEXT_PUBLIC_APP_URL=https://alam.kz
# Username бота без @ (для Telegram Login Widget)
NEXT_PUBLIC_BOT_USERNAME=alam_kz_bot

# Supabase (этап 3)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (этапы 4, 10)
BOT_TOKEN=
# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=
# Telegram ID администраторов через запятую
ADMIN_TG_IDS=
# Секрет для вызова cron-эндпоинта (Vercel задаёт CRON_SECRET)
CRON_SECRET=
